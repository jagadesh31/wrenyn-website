DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres


ADMIN_SECRET=change-me-to-a-long-random-secret
ADMIN_PASSWORD=change-me-to-a-strong-password

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget). The site key is public and baked in at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
